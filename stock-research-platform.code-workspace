{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"conventionalCommits.scopes": [
			"stockDB",
			"snapshot",
			"app",
			"docs",
			"core"
		],
		"testing.coverageToolbarEnabled": true,
		"cSpell.words": [
			"groq",
			"mantine",
			"stockdb",
			"stocksense",
			"talib",
			"timeperiod"
		],
		"editor.fontFamily": "'Monaspace Argon NF', monospace",
		"ruff.format.preview": true,
		"ruff.organizeImports": true,
		"mcp": {
			"servers": {
				"llama_index_docs": {
					"url": "https://developers.llamaindex.ai/mcp",
					"type": "http"
				},
				"agno": {
					"url": "https://docs.agno.com/mcp",
					"type": "http"
				}
			},
			"inputs": []
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "stockdb api",
				"type": "shell",
				"command": "cd ${cwd}/stockdb && uv run uvicorn main:app --reload --no-access-log --port 9000",
				"problemMatcher": [
					"$python"
				]
			},
			{
				"label": "streamlit app",
				"type": "shell",
				"command": "cd ${cwd}/webapp && uv run run.py",
				"problemMatcher": [
					"$python"
				]
			},
			{
				"label": "reflex compile",
				"type": "shell",
				"command": "cd ${cwd}/stocksense-app && uv run reflex compile",
				"problemMatcher": [
					"$python"
				]
			},
			{
				"label": "reflex run",
				"type": "shell",
				"command": "cd ${cwd}/stocksense-app && uv run reflex run",
				"problemMatcher": [
					"$python"
				]
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug Streamlit App",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/webapp/.venv/Scripts/streamlit.exe",
				"args": [
					"run",
					"${workspaceFolder}/webapp/main.py"
				],
				"console": "integratedTerminal",
				"justMyCode": true
			},
			{
				"name": "Debug StockDB API",
				"type": "debugpy",
				"request": "launch",
				"program": "${workspaceFolder}/stockdb/.venv/Scripts/uvicorn.exe",
				"args": [
					"main:app",
					"--reload",
					"--no-access-log",
					"--port",
					"9000"
				],
				"console": "integratedTerminal",
				"justMyCode": false
			}
		]
	}
}